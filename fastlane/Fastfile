default_platform(:ios)

require "json"
require "shellwords"

# Replace these four values for the app you ship. TEAMID and the installer
# certificate name have to match the certificates in the repository secrets.
XCODEPROJ = "Vowel Practice.xcodeproj"
SCHEME = "Vowel Practice"
APP_TARGET = "Vowel Practice"
BUNDLE_ID = "net.phor.FormantPlotter"
TEAM_ID = "8Q693ZG5RN"
INSTALLER_CERT_NAME = "3rd Party Mac Developer Installer: William Entriken (8Q693ZG5RN)"
INTERNAL_BETA_GROUP = "App Store Connect Users"
RELEASE_NOTES_LIMIT = 3500

# App Store locale, AppleLanguages, AppleLocale. Add a row for each language
# you ship. Norwegian Bokmål's App Store code is "no".
SCREENSHOT_LOCALES = [
  ["en-US", "en", "en_US"]
].freeze

# Prefer the newest simulator whose pixels match an App Store screenshot size.
# deliver accepts 1320×2868 for the 6.9-inch iPhone and 2064×2752 for the 13-inch iPad.
IOS_DEVICES = [
  { names: ["iPhone 18 Pro Max", "iPhone 17 Pro Max"], label: "iphone_69" },
  { names: ["iPad Pro 13-inch (M5)", "iPad Pro 13-inch (M4)"], label: "ipad_pro_13" }
].freeze

# fastlane 2.240 sends these two answers. It does not send the Advertising
# Identifier answer, and it does not upload the App Privacy questionnaire.
# Those stay in App Store Connect from the last time a person filled them in.
SUBMISSION_INFORMATION = {
  export_compliance_uses_encryption: false,
  content_rights_contains_third_party_content: false
}.freeze

def repo_root
  File.expand_path("..", __dir__)
end

def xcodeproj_path
  File.join(repo_root, XCODEPROJ)
end

def pbxproj_path
  File.join(xcodeproj_path, "project.pbxproj")
end

def shell!(*args)
  sh(args.map { |arg| Shellwords.escape(arg.to_s) }.join(" "))
end

def require_identity!
  UI.user_error!("Set TEAM_ID in fastlane/Fastfile") if TEAM_ID == "TEAMID"
  UI.user_error!("Set INSTALLER_CERT_NAME in fastlane/Fastfile") if INSTALLER_CERT_NAME.include?("Your Name")
end

def set_marketing_version!(new_version)
  require "xcodeproj"

  project = Xcodeproj::Project.open(xcodeproj_path)
  target = project.targets.find { |candidate| candidate.name == APP_TARGET }
  UI.user_error!("Target #{APP_TARGET} not found in #{xcodeproj_path}") unless target

  target.build_configurations.each do |config|
    config.build_settings["MARKETING_VERSION"] = new_version
  end

  project.save
  # xcodeproj rewrites the project and drops comments. Release Please finds the
  # version by the marker on this line. The project path is the .xcodeproj
  # directory; the text lives in project.pbxproj.
  text = File.read(pbxproj_path)
  marked = text.gsub(
    /MARKETING_VERSION = #{Regexp.escape(new_version)};(?! \/\* x-release-please-version \*\/)/,
    "MARKETING_VERSION = #{new_version}; /* x-release-please-version */"
  )
  File.write(pbxproj_path, marked) if marked != text
end

def apply_version_file!
  path = File.join(repo_root, "VERSION")
  UI.user_error!("VERSION is missing") unless File.exist?(path)
  version = File.read(path).strip.split(/\s+/).first
  UI.user_error!("VERSION #{version.inspect} is not a major.minor.patch version") unless version&.match?(/\A\d+\.\d+\.\d+\z/)
  set_marketing_version!(version)
  version
end

def semver(version)
  version.split(".").map(&:to_i)
end

# Apple rejects builds for a version that is already on sale (altool 90186).
# The bump stays on the runner. VERSION is still owned by Release Please.
def open_train_version!(version)
  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  UI.user_error!("App #{BUNDLE_ID} was not found in App Store Connect") unless app
  closed = ["IOS", "MAC_OS"].filter_map do |platform|
    app.get_live_app_store_version(platform: platform)&.version_string
  end
  current = semver(version)
  highest = closed.map { |item| semver(item) }.max
  return version if highest.nil? || (current <=> highest) == 1
  opened = "#{highest[0]}.#{highest[1]}.#{highest[2] + 1}"
  set_marketing_version!(opened)
  UI.important("App Store #{highest.join('.')} is closed for new builds. TestFlight will use #{opened}")
  opened
end

def changelog_notes
  path = File.join(repo_root, "CHANGELOG.md")
  UI.user_error!("CHANGELOG.md is missing") unless File.exist?(path)
  body = File.read(path).sub(/\A# [^\n]*\n+/, "")
  section = body.split(/^## /)[1]
  UI.user_error!("CHANGELOG.md has no release section") unless section
  notes = section.sub(/\A[^\n]*\n+/, "").strip
  UI.user_error!("The newest CHANGELOG.md section is empty") if notes.empty?
  notes[0, RELEASE_NOTES_LIMIT]
end

def current_build_number
  get_build_number(xcodeproj: xcodeproj_path).to_s.to_i
end

def bump_build_number!(build_number)
  increment_build_number(
    xcodeproj: xcodeproj_path,
    build_number: build_number.to_s
  )
  build_number
end

# Build numbers are shared by the iOS and macOS uploads and must strictly increase.
# The number is computed here and is not committed.
def next_remote_build_number!
  api_key = Actions.lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
  UI.user_error!("App Store Connect API key is not loaded") unless api_key
  numbers = ["ios", "osx"].map do |platform|
    latest_testflight_build_number(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      platform: platform,
      initial_build_number: 0
    ).to_i
  end
  build_number = (numbers + [current_build_number]).max + 1
  bump_build_number!(build_number)
  build_number
end

def install_profile!(platform)
  # Omitting :development and :adhoc. Passing both, even as false, makes sigh
  # treat them as enabled together. The default is an App Store profile.
  get_provisioning_profile(
    app_identifier: BUNDLE_ID,
    platform: platform
  )
  name = Actions.lane_context[SharedValues::SIGH_NAME]
  UI.user_error!("No #{platform} provisioning profile name was returned") if name.to_s.strip.empty?
  name
end

def archive_store_app!(destination:, profile_name:, output_directory:, output_name:, installer_cert_name: nil, sdk: nil)
  # build_app writes every sigh profile onto this bundle id. The macOS profile
  # is fetched second, so it was replacing the iOS one at export.
  Actions.lane_context[SharedValues::SIGH_PROFILE_PATH] = nil
  Actions.lane_context[SharedValues::SIGH_PROFILE_PATHS] = nil
  profile_name = profile_name.dup
  options = {
    project: XCODEPROJ,
    scheme: SCHEME,
    configuration: "Release",
    export_method: "app-store",
    destination: destination,
    clean: true,
    output_directory: output_directory,
    output_name: output_name,
    codesigning_identity: "Apple Distribution",
    # gym otherwise replaces the mapping with the last sigh profile, which is
    # the other platform.
    skip_profile_detection: true,
    xcargs: [
      "CODE_SIGN_STYLE=Manual",
      "DEVELOPMENT_TEAM=#{TEAM_ID}",
      "CODE_SIGN_IDENTITY=#{Shellwords.escape("Apple Distribution")}",
      "PROVISIONING_PROFILE_SPECIFIER=#{Shellwords.escape(profile_name)}"
    ].join(" "),
    export_options: {
      signingStyle: "manual",
      teamID: TEAM_ID,
      provisioningProfiles: {
        BUNDLE_ID => profile_name
      }
    }
  }
  options[:installer_cert_name] = installer_cert_name if installer_cert_name
  # A multiplatform project is packaged as a pkg only when the sdk is macosx.
  # Otherwise gym looks for an ipa and reports "IPA invalid".
  # output_name for the pkg is the app name. gym appends .pkg.
  options[:sdk] = sdk if sdk
  build_app(options)
end

# upload_to_testflight can return a stale previousBundleVersion for an app
# that already has a shipped version. altool is the upload that succeeds.
def altool_upload!(binary_path, type:)
  config_path = File.expand_path("api_key.json", __dir__)
  UI.user_error!("Missing fastlane/api_key.json — needed for altool upload") unless File.exist?(config_path)

  config = JSON.parse(File.read(config_path))
  key_id = config.fetch("key_id")
  issuer_id = config.fetch("issuer_id")
  key_filepath = File.expand_path(config.fetch("key_filepath"))
  UI.user_error!("API key file not found at #{key_filepath}") unless File.exist?(key_filepath)

  search_dirs = [
    File.expand_path("~/.appstoreconnect/private_keys"),
    File.expand_path("~/.private_keys"),
    File.expand_path("~/private_keys"),
    File.expand_path("./private_keys")
  ]
  unless search_dirs.any? { |dir| File.exist?(File.join(dir, "AuthKey_#{key_id}.p8")) }
    target_dir = search_dirs.first
    FileUtils.mkdir_p(target_dir)
    FileUtils.cp(key_filepath, File.join(target_dir, "AuthKey_#{key_id}.p8"))
  end

  shell!(
    "xcrun", "altool", "--upload-app",
    "-f", binary_path,
    "-t", type,
    "--apiKey", key_id,
    "--apiIssuer", issuer_id
  )
end

def wait_for_processed_build!(version:, build_number:, platform:)
  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  UI.user_error!("App #{BUNDLE_ID} was not found in App Store Connect") unless app
  deadline = Time.now + (40 * 60)
  loop do
    UI.user_error!("Timed out waiting for #{platform} build #{build_number} to finish processing") if Time.now > deadline
    build = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      version: version,
      build_number: build_number.to_s,
      platform: platform
    ).first
    state = build&.processing_state
    UI.message("#{platform} build #{version} (#{build_number}) processing state: #{state || "not uploaded yet"}")
    return build if state == Spaceship::ConnectAPI::Build::ProcessingState::VALID
    if [
      Spaceship::ConnectAPI::Build::ProcessingState::FAILED,
      Spaceship::ConnectAPI::Build::ProcessingState::INVALID
    ].include?(state)
      UI.user_error!("#{platform} build processing finished as #{state}")
    end
    sleep(30)
  end
end

def distribute_build!(version:, build_number:, platform:)
  build = wait_for_processed_build!(version: version, build_number: build_number, platform: platform)
  begin
    build.update(attributes: { uses_non_exempt_encryption: false })
  rescue Spaceship::UnexpectedResponse => error
    raise unless error.message.include?("usesNonExemptEncryption")
    UI.message("#{platform} build already has the encryption answer")
  end
  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  groups = app.get_beta_groups
  # The default internal group name can contain a non-breaking space.
  group = groups.find do |candidate|
    candidate.is_internal_group && candidate.name.to_s.gsub(/[[:space:]]+/, " ").strip == INTERNAL_BETA_GROUP
  end
  group ||= groups.find(&:is_internal_group)
  UI.user_error!("No internal TestFlight group named #{INTERNAL_BETA_GROUP}") unless group
  if group.has_access_to_all_builds
    UI.success("#{group.name} already receives every #{platform} build, including #{version} (#{build_number})")
  else
    build.add_beta_groups(beta_groups: [group])
    UI.success("Added #{platform} build #{version} (#{build_number}) to #{group.name}")
  end
end

def github_output!(version:, build_number:)
  path = ENV["GITHUB_OUTPUT"]
  return unless path && !path.empty?
  File.open(path, "a") do |file|
    file.puts "version=#{version}"
    file.puts "build_number=#{build_number}"
  end
end

def latest_simulator_for(device_name, platform_name)
  raw = sh("xcrun simctl list devices available --json", log: false)
  devices_json = JSON.parse(raw).fetch("devices", {})
  candidates = []

  devices_json.each do |runtime_key, simulators|
    next unless runtime_key.include?(platform_name)
    version_match = runtime_key.match(/#{Regexp.escape(platform_name)}[- ]([\d\.-]+)/i)
    version = version_match ? version_match[1].tr("-", ".") : "0"
    simulators.each do |sim|
      next if sim["isAvailable"] == false
      next unless sim["name"] == device_name
      udid = sim["udid"] || sim["identifier"]
      next if udid.to_s.strip.empty?
      candidates << { name: device_name, version: version, udid: udid }
    end
  end

  return nil if candidates.empty?
  candidates.max_by { |candidate| Gem::Version.new(candidate[:version]) }
end

def require_simulator(names, platform_name)
  names.each do |name|
    found = latest_simulator_for(name, platform_name)
    return found.merge(name: name) if found
  end
  UI.user_error!("No available #{platform_name} simulator found for #{names.join(" or ")}")
end

def launch_args(language, apple_locale, screenshot)
  # The second store shot is the chart page. MainView reads -viewMode.
  # -AppleLanguages does not change Locale.current in a Mac process that was
  # launched directly. The app reads -AppleLocale itself.
  mode = screenshot ? "chart" : "formant"
  ["-viewMode", mode, "-AppleLanguages", "(#{language})", "-AppleLocale", apple_locale]
end

def capture_simulator_shot!(udid, screenshot, destination, language, apple_locale)
  sh("xcrun simctl terminate #{Shellwords.escape(udid)} #{Shellwords.escape(BUNDLE_ID)} >/dev/null 2>&1 || true")
  shell!("xcrun", "simctl", "launch", udid, BUNDLE_ID, *launch_args(language, apple_locale, screenshot))
  sleep(2)
  shell!("xcrun", "simctl", "io", udid, "screenshot", destination)
  sh("xcrun simctl terminate #{Shellwords.escape(udid)} #{Shellwords.escape(BUNDLE_ID)} >/dev/null 2>&1 || true")
end

def capture_ios_screenshots!(output_root)
  devices = IOS_DEVICES.map { |device| device.merge(require_simulator(device[:names], "iOS")) }
  derived = File.join(repo_root, "build", "screenshot-ios")
  shell!(
    "xcodebuild",
    "-project", xcodeproj_path,
    "-scheme", SCHEME,
    "-configuration", "Release",
    "-destination", "platform=iOS Simulator,id=#{devices.first[:udid]}",
    "-derivedDataPath", derived,
    "CODE_SIGNING_ALLOWED=NO",
    "build"
  )
  app = Dir.glob(File.join(derived, "Build", "Products", "*-iphonesimulator", "#{APP_TARGET}.app")).first
  UI.user_error!("Could not find the iOS simulator app") unless app

  devices.each do |device|
    sh("xcrun simctl boot #{Shellwords.escape(device[:udid])} >/dev/null 2>&1 || true")
    shell!("xcrun", "simctl", "bootstatus", device[:udid], "-b")
    shell!("xcrun", "simctl", "install", device[:udid], app)
  end

  SCREENSHOT_LOCALES.each do |asc, language, apple_locale|
    directory = File.join(output_root, "ios", asc)
    FileUtils.mkdir_p(directory)
    devices.each do |device|
      capture_simulator_shot!(device[:udid], false, File.join(directory, "01_#{device[:label]}.png"), language, apple_locale)
      capture_simulator_shot!(device[:udid], true, File.join(directory, "02_#{device[:label]}.png"), language, apple_locale)
    end
  end

  devices.each do |device|
    sh("xcrun simctl shutdown #{Shellwords.escape(device[:udid])} >/dev/null 2>&1 || true")
  end
end

def capture_mac_shot!(executable, destination, language, apple_locale, screenshot)
  FileUtils.rm_f(destination)
  shell!(
    executable,
    *launch_args(language, apple_locale, screenshot),
    "-screenshot-file",
    destination
  )
  UI.user_error!("Mac screenshot was not written to #{destination}") unless File.size?(destination).to_i > 1000
end

def capture_mac_screenshots!(output_root)
  derived = File.join(repo_root, "build", "screenshot-macos")
  # Sandbox stays on for the store archive. This build has to write the PNG into the workspace.
  shell!(
    "xcodebuild",
    "-project", xcodeproj_path,
    "-scheme", SCHEME,
    "-configuration", "Release",
    "-destination", "platform=macOS",
    "-derivedDataPath", derived,
    "CODE_SIGNING_ALLOWED=NO",
    "ENABLE_APP_SANDBOX=NO",
    "build"
  )
  app = Dir.glob(File.join(derived, "Build", "Products", "Release", "#{APP_TARGET}.app")).first
  UI.user_error!("Could not find the macOS app") unless app
  shell!("codesign", "--force", "--deep", "--sign", "-", app)
  executable = File.join(app, "Contents", "MacOS", APP_TARGET)

  SCREENSHOT_LOCALES.each do |asc, language, apple_locale|
    directory = File.join(output_root, "macos", asc)
    FileUtils.mkdir_p(directory)
    capture_mac_shot!(executable, File.join(directory, "01_mac.png"), language, apple_locale, false)
    capture_mac_shot!(executable, File.join(directory, "02_mac.png"), language, apple_locale, true)
  end
end

# A locale directory with a name but no description, keywords, or support URL
# makes Apple reject the version. The live listing is en-US. Any other locale
# directory must still contain those fields, copied from en-US when absent.
REQUIRED_METADATA = %w[description.txt keywords.txt support_url.txt marketing_url.txt privacy_url.txt].freeze

def prepare_metadata!(metadata_path, notes)
  source = File.join(metadata_path, "en-US")
  UI.user_error!("#{metadata_path} is missing en-US") unless File.directory?(source)
  SCREENSHOT_LOCALES.each do |asc, _, _|
    destination = File.join(metadata_path, asc)
    next if File.directory?(destination)
    FileUtils.cp_r(source, destination)
  end
  Dir.children(metadata_path).each do |entry|
    directory = File.join(metadata_path, entry)
    next unless File.directory?(directory)
    next if entry == "review_information"
    REQUIRED_METADATA.each do |filename|
      target = File.join(directory, filename)
      next if File.file?(target) && !File.read(target).strip.empty?
      fallback = File.join(source, filename)
      FileUtils.cp(fallback, target) if File.file?(fallback)
    end
    File.write(File.join(directory, "release_notes.txt"), "#{notes}\n")
  end
end

def submit_store!(platform:, version:, build_number:, metadata_path:, screenshots_path:)
  upload_to_app_store(
    platform: platform,
    app_version: version,
    build_number: build_number.to_s,
    metadata_path: metadata_path,
    screenshots_path: screenshots_path,
    skip_binary_upload: true,
    skip_metadata: false,
    skip_screenshots: false,
    overwrite_screenshots: true,
    submit_for_review: true,
    automatic_release: true,
    submission_information: SUBMISSION_INFORMATION,
    force: true,
    run_precheck_before_submit: false,
    precheck_include_in_app_purchases: false
  )
end

before_all do
  # Xcode's IPA export calls rsync -E. Homebrew rsync rejects that flag
  # ("Copy failed"). setup-ruby is not installed under these prefixes.
  sanitized = ENV["PATH"].split(":").reject { |path| path.start_with?("/opt/homebrew", "/usr/local") }
  ENV["PATH"] = sanitized.join(":")

  config_path = File.expand_path("api_key.json", __dir__)
  next unless File.exist?(config_path)

  config = JSON.parse(File.read(config_path))
  app_store_connect_api_key(
    key_id: config["key_id"],
    issuer_id: config["issuer_id"],
    key_filepath: config["key_filepath"],
    in_house: config.fetch("in_house", false)
  )
end

desc "Upload this commit to TestFlight for iOS and macOS and distribute it to the internal group. The marketing version comes from VERSION. The build number is not committed."
lane :ship_testflight do
  require_identity!
  version = open_train_version!(apply_version_file!)
  build_number = next_remote_build_number!
  ios_profile = install_profile!("ios")
  mac_profile = install_profile!("macos")
  UI.message("TestFlight #{version} (#{build_number})")

  archive_store_app!(
    destination: "generic/platform=iOS",
    profile_name: ios_profile,
    output_directory: "build/ios",
    output_name: "#{APP_TARGET}.ipa"
  )
  ipa = Dir.glob(File.join(repo_root, "build", "ios", "*.ipa")).first
  UI.user_error!("iOS ipa was not exported") unless ipa
  altool_upload!(ipa, type: "ios")
  distribute_build!(version: version, build_number: build_number, platform: "IOS")

  archive_store_app!(
    destination: "generic/platform=macOS",
    profile_name: mac_profile,
    output_directory: "build/macos",
    output_name: APP_TARGET,
    installer_cert_name: INSTALLER_CERT_NAME,
    sdk: "macosx"
  )
  pkg = Dir.glob(File.join(repo_root, "build", "macos", "*.pkg")).first
  UI.user_error!("macOS pkg was not exported") unless pkg
  altool_upload!(pkg, type: "macos")
  distribute_build!(version: version, build_number: build_number, platform: "MAC_OS")
  github_output!(version: version, build_number: build_number)
end

desc "Generate iPhone, iPad, and Mac screenshots for SCREENSHOT_LOCALES. Files are written under fastlane/screenshots and are not committed."
lane :generate_screenshots do
  apply_version_file!
  output_root = File.expand_path("screenshots", __dir__)
  FileUtils.rm_rf(output_root)
  capture_ios_screenshots!(output_root)
  capture_mac_screenshots!(output_root)
  UI.success("Screenshots saved under fastlane/screenshots")
end

desc "Upload generated screenshots for the TestFlight version on iOS and Mac. Does not submit for review."
lane :upload_screenshots do
  require_identity!
  version = open_train_version!(apply_version_file!)
  notes = File.exist?(File.join(repo_root, "CHANGELOG.md")) ? changelog_notes : "Maintenance update."
  ios_screenshots = File.expand_path("screenshots/ios", __dir__)
  mac_screenshots = File.expand_path("screenshots/macos", __dir__)
  UI.user_error!("iOS screenshots are missing") if Dir.glob(File.join(ios_screenshots, "**", "*.png")).empty?
  UI.user_error!("macOS screenshots are missing") if Dir.glob(File.join(mac_screenshots, "**", "*.png")).empty?
  prepare_metadata!(File.expand_path("metadata", __dir__), notes)
  prepare_metadata!(File.expand_path("metadata-macos", __dir__), notes)
  [ios_screenshots, mac_screenshots].each_with_index do |screenshots_path, index|
    upload_to_app_store(
      platform: index.zero? ? "ios" : "osx",
      app_version: version,
      metadata_path: File.expand_path(index.zero? ? "metadata" : "metadata-macos", __dir__),
      screenshots_path: screenshots_path,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false
    )
  end
  UI.success("Uploaded screenshots for #{version}")
end

# Review has to name the version that was uploaded. ship_testflight may have
# moved one patch past VERSION when that version was already on sale.
def version_for_review!(options)
  uploaded = options[:version].to_s.strip
  return uploaded unless uploaded.empty?
  open_train_version!(apply_version_file!)
end

desc "Submit the TestFlight build to App Store review for iOS and macOS. Pass build_number: and version: from the TestFlight upload. Screenshots must already be under fastlane/screenshots. What's New is the newest CHANGELOG.md section."
lane :submit_app_store do |options|
  require_identity!
  version = version_for_review!(options)
  build_number = options[:build_number].to_s.strip
  UI.user_error!("Pass build_number: from the TestFlight upload") if build_number.empty?
  notes = changelog_notes

  ios_screenshots = File.expand_path("screenshots/ios", __dir__)
  mac_screenshots = File.expand_path("screenshots/macos", __dir__)
  UI.user_error!("iOS screenshots are missing") if Dir.glob(File.join(ios_screenshots, "**", "*.png")).empty?
  UI.user_error!("macOS screenshots are missing") if Dir.glob(File.join(mac_screenshots, "**", "*.png")).empty?

  prepare_metadata!(File.expand_path("metadata", __dir__), notes)
  prepare_metadata!(File.expand_path("metadata-macos", __dir__), notes)

  submit_store!(
    platform: "ios",
    version: version,
    build_number: build_number,
    metadata_path: File.expand_path("metadata", __dir__),
    screenshots_path: ios_screenshots
  )
  submit_store!(
    platform: "osx",
    version: version,
    build_number: build_number,
    metadata_path: File.expand_path("metadata-macos", __dir__),
    screenshots_path: mac_screenshots
  )
  UI.success("Submitted #{version} (#{build_number}) for iOS and macOS review")
end
